---
import AdjacentPostLink from "./AdjacentPostLink.astro";

type AdjacentPost = {
  id: string;
  title: string;
  filePath: string | undefined;
} | null;

type Props = {
  prevPost: AdjacentPost;
  nextPost: AdjacentPost;
  seriesPrevPost: AdjacentPost;
  seriesNextPost: AdjacentPost;
  series?: string;
};

const { prevPost, nextPost, seriesPrevPost, seriesNextPost, series } =
  Astro.props;
---

<div data-pagefind-ignore>
  <div data-global-post-nav class="my-8 grid grid-cols-1 gap-6 sm:grid-cols-2">
    {prevPost && <AdjacentPostLink post={prevPost} direction="prev" />}
    {nextPost && <AdjacentPostLink post={nextPost} direction="next" />}
  </div>

  {
    series && (
      <div
        data-series-post-nav={series}
        class="my-8 hidden grid-cols-1 gap-6 sm:grid-cols-2"
      >
        {seriesPrevPost && (
          <AdjacentPostLink post={seriesPrevPost} direction="prev" {series} />
        )}
        {seriesNextPost && (
          <AdjacentPostLink post={seriesNextPost} direction="next" {series} />
        )}
      </div>
    )
  }
</div>

<script>
  function updateAdjacentPostNav() {
    const series = new URLSearchParams(window.location.search).get("series");
    const globalNav = document.querySelector<HTMLElement>(
      "[data-global-post-nav]"
    );
    const seriesNav = series
      ? document.querySelector<HTMLElement>(
          `[data-series-post-nav="${CSS.escape(series)}"]`
        )
      : null;

    globalNav?.classList.toggle("hidden", Boolean(seriesNav));
    seriesNav?.classList.remove("hidden");
    seriesNav?.classList.add("grid");
  }

  document.addEventListener("astro:page-load", updateAdjacentPostNav);
  updateAdjacentPostNav();
</script>
