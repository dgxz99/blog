---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { toTransitionName } from "@/utils/toTransitionName";
import { slugifyStr } from "@/utils/slugify";
import Datetime from "./Datetime.astro";
import Series from "./Series.astro";

type Props = {
  variant?: "h2" | "h3";
  seriesContext?: boolean;
} & CollectionEntry<"posts">;

const {
  variant: Heading = "h2",
  seriesContext = false,
  id,
  data,
  filePath,
} = Astro.props;

const { title, description, ...props } = data;
const postUrl = getPostUrl(data.id, filePath, Astro.currentLocale);
const href =
  seriesContext && data.series
    ? `${postUrl}?series=${encodeURIComponent(slugifyStr(data.series))}`
    : postUrl;
---

<li class="my-6">
  <a
    {href}
    class:list={[
      "text-accent inline-block text-lg font-medium",
      "decoration-dashed underline-offset-4 hover:underline",
      "focus-visible:no-underline focus-visible:underline-offset-0",
    ]}
  >
    <Heading transition:name={toTransitionName(id)}>
      {title}
    </Heading>
  </a>
  <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
    <Datetime {...props} />
    {data.series && <Series name={data.series} compact class="text-sm" />}
  </div>
  <p>{description}</p>
</li>
