---
import { getRelativeLocaleUrl } from "astro:i18n";
import { slugifyStr } from "@/utils/slugify";
import { useTranslations } from "@/i18n";
import config from "@/config";

type Props = {
  name: string;
  count?: number;
  compact?: boolean;
  class?: string;
};

const { name, count, compact = false, class: className } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const countLabel = count === 1 ? t.series.post : t.series.posts;
---

<a
  href={getRelativeLocaleUrl(locale, `series/${slugifyStr(name)}/`)}
  class:list={[
    "hover:text-accent inline-flex items-center gap-2 transition-colors",
    compact
      ? "before:border-border hover:before:border-accent gap-2 px-0 before:h-4 before:border-s-2 before:transition-colors"
      : "border-border hover:border-accent border-s-2 px-3 py-1.5",
    className,
  ]}
>
  <span>{name}</span>
  {
    count !== undefined && (
      <span class="text-muted-foreground text-sm">
        · {count} {countLabel}
      </span>
    )
  }
</a>
